generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Inquiry {
  id           String   @id @default(cuid())
  studentName  String
  phone        String
  currentClass String?
  program      String?
  message      String?
  createdAt    DateTime @default(now())
}
